# M7 live-check settings TEMPLATE. Copy to live-check/.env.m7 (gitignored) for a live run.
# Never put real keys in this template, and never commit .env.m7.
#
# In the Claude cloud sandbox the keys are NOT stored here: they are entered in the secure
# credential form and injected by the network proxy. Use any placeholder value then, for
# example HIVE_API_KEY=placeholder, so the script knows a key is expected.

# Only the live-check script reads this file. The app and Docker Compose do not.
HIVE_MODE=real
GROQ_MODE=real

HIVE_API_KEY=
GROQ_API_KEY=

# Official endpoints (empty = defaults).
HIVE_API_URL=
GROQ_BASE_URL=

# One attempt each: no retries, one Groq model, so at most one billed request per service.
HIVE_RETRIES=0
HIVE_TIMEOUT_MS=15000
GROQ_RETRIES=0
GROQ_TIMEOUT_MS=20000
GROQ_MODEL_EXPLAIN=openai/gpt-oss-120b
GROQ_MODEL_FALLBACKS=
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_REASONING_EFFORT=low
GROQ_TEMPERATURE=0.2

# Required, in addition to --live, before any network call is made.
M7_LIVE=0
