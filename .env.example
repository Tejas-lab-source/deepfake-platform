# Copy to .env and edit. Never commit .env.
# docker compose works without a .env file: every value below has a dev default.

# true = deterministic fake scores, no GPU, no weights, no API keys.
MOCK_MODE=true

# Real mode: set MOCK_MODE=false and WITH_ML=true, run scripts/download_weights.sh, then
# rebuild with `docker compose up --build`. DEVICE is auto, cpu or cuda.
WITH_ML=false
DEVICE=auto

# Shared secret between the Node server and the private ML service.
INTERNAL_SECRET=dev-internal-secret-change-me

# JWT signing secrets. Use long random strings outside development.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Published ports on the host.
WEB_PORT=8080
SERVER_PORT=4000

# Pipeline: number of beautified copies per face (0 = fast mode).
K=4

# Hours before uploaded media expires.
MEDIA_TTL_HOURS=24

# ---- Phase 4: external APIs ---------------------------------------------------------
# Keys belong only in .env (never committed). Leave them empty to run without the APIs.
# Neither service is assumed to be free: every request counts against a daily budget.

# Hive second opinion. HIVE_MODE: mock | real | off; empty follows MOCK_MODE.
# A file is sent to Hive only when the uploader ticks the per-upload consent box.
HIVE_MODE=
HIVE_API_KEY=
# Empty uses the official v3 endpoint:
# https://api.thehive.ai/api/v3/hive/ai-generated-and-deepfake-content-detection
HIVE_API_URL=
HIVE_THRESHOLD=0.9
HIVE_TIMEOUT_MS=15000
# Hive v3's documented default limit is 100 requests a day. 20 are reserved for the demo pool
# (users with the admin role); everyone else is capped at HIVE_USER_DAILY_LIMIT a day.
HIVE_DAILY_LIMIT=100
HIVE_DEMO_RESERVE=20
HIVE_USER_DAILY_LIMIT=10
# Each retry is a separately billed request.
HIVE_RETRIES=0

# Groq explanations. GROQ_MODE: mock | real | off; empty follows MOCK_MODE.
# mock and off use the built-in template; real falls back to it on any failure.
GROQ_MODE=
GROQ_API_KEY=
# Empty uses https://api.groq.com/openai/v1
GROQ_BASE_URL=
GROQ_MODEL_EXPLAIN=openai/gpt-oss-120b
GROQ_MODEL_CHAT=openai/gpt-oss-20b
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=20000
GROQ_RETRIES=2
GROQ_DAILY_LIMIT=900
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_REASONING_EFFORT=low
GROQ_TEMPERATURE=0.2
