# Copy to .env and edit. Never commit .env.
# docker compose works without a .env file: every value below has a dev default.

# true = deterministic fake scores, no GPU, no weights, no API keys.
MOCK_MODE=true

# Shared secret between the Node server and the private ML service.
INTERNAL_SECRET=dev-internal-secret-change-me

# JWT signing secrets. Use long random strings outside development.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Published ports on the host.
WEB_PORT=8080
SERVER_PORT=4000

# Pipeline: number of beautified copies per face (0 = fast mode).
K=4

# Hours before uploaded media expires.
MEDIA_TTL_HOURS=24

# Hive second opinion (used when MOCK_MODE=false; client arrives in Phase 4).
HIVE_API_KEY=
HIVE_THRESHOLD=0.9
HIVE_TIMEOUT_MS=15000

# Groq explanations (used when MOCK_MODE=false; client arrives in Phase 4).
GROQ_API_KEY=
GROQ_MODEL_EXPLAIN=openai/gpt-oss-120b
GROQ_MODEL_CHAT=openai/gpt-oss-20b
